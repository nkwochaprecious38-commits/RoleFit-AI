# ============================================================
# RoleFit AI — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local or any file containing real secrets.
# ============================================================

# --- Supabase (required) ---
# Found in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key — server-side only, never exposed to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- AI Provider (optional — platform works without it using local fallbacks) ---
# Supports Anthropic Claude or any OpenAI-compatible API

# Your API key (Anthropic or OpenAI-compatible provider)
AI_API_KEY=your-ai-api-key-here

# Model identifier
# Anthropic examples: claude-opus-4-5, claude-sonnet-4-5, claude-haiku-4-5
# OpenAI examples:    gpt-4o, gpt-4o-mini
AI_MODEL=claude-sonnet-4-5

# Base URL — set only for non-Anthropic providers
# Anthropic: leave unset (default) — the service auto-detects via AI_API_KEY prefix
# OpenAI:    https://api.openai.com
# Custom:    https://your-openai-compatible-endpoint.com
AI_BASE_URL=

# --- App (optional) ---
# Base URL for auth callback redirects (defaults to http://localhost:3000 in dev)
NEXT_PUBLIC_APP_URL=https://your-domain.com
